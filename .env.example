# Copy to .env.local and fill in. .env.local is gitignored.
#
# This app shares the LifeOS Supabase project. Its tables live in the
# `cookbook` Postgres schema; LifeOS owns `public`. Same values as LifeOS's
# .env.local.

# --- Database -------------------------------------------------------------
# Both go through the SESSION pooler (port 5432), never transaction mode
# (6543) — postgres.js hangs on transaction mode under query depth. See
# C:\D\LifeOS\src\server\db\index.ts for the measurements.
DATABASE_URL=
DIRECT_URL=

# --- API ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (sb_publishable_...). Auth only; data goes through src/server.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_...). Server-side only. Used by scripts/mint-token.mts
# to look up the auth user by email.
SUPABASE_SECRET_KEY=

# Test account for manual/browser checks (pnpm seed:test). Never a real person.
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=
